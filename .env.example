# Database
DATABASE_URL="postgresql://calling:calling_dev@localhost:5434/calling?schema=public"

# Seed (optional dev data: org + admin user)
SEED_DEV_DATA="false"
DEV_ADMIN_EMAIL="admin@example.com"
DEV_ADMIN_PASSWORD="ChangeMe123!"

# Redis (Phase 2+)
REDIS_URL="redis://localhost:6379"

# JWT (Phase 2+)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server (Phase 2+)
PORT=4000
VOICE_WS_PORT=4001
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
API_BASE_URL="http://localhost:4000"

# Exotel (Phase 2+)
EXOTEL_ACCOUNT_SID=""
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_CALLER_ID=""
EXOTEL_FLOW_URL=""
EXOTEL_WEBHOOK_SECRET=""

# AI Providers (Phase 2+)
OPENAI_API_KEY=""
DEEPGRAM_API_KEY=""
TTS_PROVIDER="openai"

# Storage (Phase 2+)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# Frontend (Phase 3+)
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
